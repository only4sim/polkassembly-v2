rules_version = '2';

// Firestore security rules — DemoOS (points-based) configuration.
//
// Access model (frozen PR-2):
//   - ALL client writes are denied. Every mutation goes through the Admin SDK
//     (trusted Next.js API routes / Cloud Functions), which bypasses these rules.
//     Verified 2026-09-07: the client bundle contains zero addDoc/setDoc/updateDoc/
//     deleteDoc/transaction calls; the only client reads are the three listed below.
//   - Client reads are minimal-privilege:
//       * users/{uid}: only the owner (documents contain email PII + role/pointsBalance)
//       * posts/{id}/votes/{uid}: only the owner
//       * everything else listed below: public read
//   - `counters/*` documents are allocation primitives with no client use case:
//     fully inaccessible to clients.

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== Users ==========
    // Documents contain email (PII), role and pointsBalance. Clients may only
    // read their own document; profile data for other users is served through
    // trusted API routes which project public fields.
    match /users/{uid} {
      allow get, list: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false; // Admin SDK only
    }

    // ========== Counters ==========
    // Index-allocation primitives. No legitimate client use case.
    match /counters/{counter} {
      allow read, write: if false; // Admin SDK only
    }

    // ========== Referenda (points-based) ==========
    match /referenda/{index} {
      // Listing and detail pages read referenda publicly.
      allow get, list: if true;
      // Lifecycle, creation and deletion are trusted-server operations only.
      allow create, update, delete: if false;

      match /votes/{uid} {
        // One vote per UID, keyed by the voter's Firebase UID: owner-only read.
        allow get, list: if request.auth != null && request.auth.uid == uid;
        // Voting/removal goes through PUT/DELETE /api/v2/referenda/{index}/votes/me.
        allow create, update, delete: if false;
      }

      match /stats/{statId} {
        // Realtime aggregate results are public by design.
        allow get, list: if true;
        allow create, update, delete: if false; // Trusted transaction only
      }

      match /comments/{commentId} {
        // Referendum comments are public content (plan PR-7).
        allow get, list: if true;
        // Comment CRUD is served by trusted comment API routes (Admin SDK);
        // clients never write comments directly.
        allow create, update, delete: if false;
      }
    }

    // ========== DemoOS posts (discussions) ==========
    match /posts/{postId} {
      // Post lists and details are public.
      allow get, list: if true;
      // All writes (create/update/delete/moderation/vote-counters) are performed by
      // trusted server routes (DemoPostService via Admin SDK). Allowing client writes
      // would enable moderation-field escalation and author takeover (audit P0-5).
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow get, list: if true;
        // Comment CRUD is served by trusted comment API routes.
        allow create, update, delete: if false;
      }

      match /votes/{uid} {
        // Discussion poll votes: owner-only read.
        allow get, list: if request.auth != null && request.auth.uid == uid;
        allow create, update, delete: if false; // castVote trusted path only
      }

      match /stats/{statId} {
        // Realtime poll results are public.
        allow get, list: if true;
        allow create, update, delete: if false;
      }
    }

    // ========== Deny all other access ==========
    match /{document=**} {
      allow read, write: if false;
    }
  }
}